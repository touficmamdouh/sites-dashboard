#!/bin/bash
# postinst - finalize sites-dashboard install
set -e

# 1. Python packages
python3 -m pip install --quiet typer rich textual 2>/dev/null || pip3 install --quiet typer rich textual || true

# 2. detect php fpm socket
detect_php() {
    for v in /run/php/php*-fpm.sock; do
        [ -S "$v" ] && { echo "$v"; return; }
    done
    echo "/run/php/php8.3-fpm.sock"
}
PHP_SOCK=$(detect_php)
PHP_SVC=$(basename "$PHP_SOCK" .sock)

# 3. env profile for current user
HOME_DIR=$(getent passwd `logname 2>/dev/null || echo $SUDO_USER 2>/dev/null` | cut -d: -f6)
[ -z "$HOME_DIR" ] && HOME_DIR=$HOME
for pf in "$HOME_DIR/.bashrc" "$HOME_DIR/.zshrc"; do
    [ -f "$pf" ] || continue
    grep -q '^export SITES_PHP_SOCK=' "$pf" || printf '\nexport SITES_PHP_SOCK="%s"\nexport SITES_PHP_SVC="%s"\n' "$PHP_SOCK" "$PHP_SVC" >> "$pf"
done

# 4. enable services
systemctl enable nginx >/dev/null 2>&1 || true
systemctl enable mariadb >/dev/null 2>&1 || true
systemctl enable mailpit >/dev/null 2>&1 || true
systemctl enable "$PHP_SVC" >/dev/null 2>&1 || true

# 5. mailpit (local mail catcher)
install_mailpit() {
    if command -v mailpit >/dev/null 2>&1; then
        echo "  ✓ mailpit already installed"
        return
    fi
    echo "  installing mailpit..."
    if [ -x /usr/local/bin/mailpit ]; then
        return
    fi
    curl -sSL -o /tmp/mailpit.tar.gz \
        "https://github.com/axllent/mailpit/releases/download/v1.30.7/mailpit-linux-amd64.tar.gz"
    tar xzf /tmp/mailpit.tar.gz -C /tmp
    install -m 755 /tmp/mailpit /usr/local/bin/mailpit
    rm -f /tmp/mailpit.tar.gz /tmp/mailpit
}
install_mailpit

# sendmail wrapper -> mailpit
if ! command -v msmtp >/dev/null 2>&1; then
    DEBIAN_FRONTEND=noninteractive apt-get install -y msmtp-mta >/dev/null 2>&1 || true
fi
tee /etc/msmtprc >/dev/null <<'MSMTP'
defaults
auth off
tls off

account local
host 127.0.0.1
port 1025
from noreply@localhost

account default : local
MSMTP
chmod 644 /etc/msmtprc

# mailpit systemd service
if ! systemctl list-unit-files 2>/dev/null | grep -q '^mailpit'; then
    tee /etc/systemd/system/mailpit.service >/dev/null <<'MAILPIT'
[Unit]
Description=Mailpit local mail server
After=network.target

[Service]
ExecStart=/usr/local/bin/mailpit --smtp 127.0.0.1:1025 --listen 127.0.0.1:8025
Restart=unless-stopped

[Install]
WantedBy=multi-user.target
MAILPIT
    systemctl daemon-reload
    systemctl enable --now mailpit >/dev/null 2>&1 || true
fi

echo ""
echo "sites-dashboard installed!"
echo "  Run:  sites dashboard"
echo "  PHP socket: $PHP_SOCK (service $PHP_SVC)"
exit 0