Version: 1.1.0
Section: admin
Priority: optional
Architecture: all
Depends: python3, python3-pip, nginx, mariadb-server, php-fpm, curl, tar, wget, msmtp-mta, ca-certificates
Recommends: certbot, python3-certbot-nginx
