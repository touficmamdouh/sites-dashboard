#!/usr/bin/env python3
"""Create a local Nginx site with optional WordPress installation."""

from __future__ import annotations

import argparse
import ipaddress
import os
import re
import secrets
import shutil
import stat
import sys
import tarfile
import tempfile
from dataclasses import dataclass, field
from pathlib import Path, PurePosixPath
from uuid import uuid4

from sites_config import RuntimeConfig, load_config
from sites_platform import CommandRunner, ServiceManager, run_command

HOSTS_PATH = Path("/etc/hosts")
WP_VERSION = "6.7"
# The runner accepts argv only. Open the private SQL file as stdin before exec,
# so batch mode stops on SQL errors without putting credentials in argv.
MYSQL_STDIN = "import os,sys; fd=os.open(sys.argv[1],os.O_RDONLY); os.dup2(fd,0); os.close(fd); os.execvp(sys.argv[2],sys.argv[2:])"


@dataclass(frozen=True)
class CreateResult:
    success: bool
    domain: str
    site_dir: Path
    error: str = ""
    db_password: str = field(default="", repr=False)


class CreationError(RuntimeError):
    pass


def checked(runner: CommandRunner, command: list[str], action: str, *, private: bool = False):
    result = runner(command)
    if result.returncode:
        # Database errors can echo SQL containing the generated password.
        detail = " Check credentials and existing database/user names." if private else f" {result.stderr or result.stdout}"
        raise CreationError(f"{action} failed (exit {result.returncode}).{detail}")
    return result


def privileged(runner: CommandRunner, command: list[str], action: str):
    return checked(runner, ["sudo", "-n", *command], action)


def validate_domain(domain: str) -> str:
    domain = domain.lower()
    if len(domain) > 253 or not all(re.fullmatch(r"[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?", label) for label in domain.split(".")):
        raise CreationError("Invalid domain: use DNS labels containing letters, digits, and hyphens, e.g. example.test.")
    try:
        ipaddress.ip_address(domain)
    except ValueError:
        return domain
    raise CreationError("Invalid domain: use a hostname, not an IP address.")


def hosts_addition(content: str, domain: str) -> str:
    found = False
    for line in content.splitlines():
        fields = line.split("#", 1)[0].split()
        if len(fields) < 2 or domain not in [name.lower().rstrip(".") for name in fields[1:]]:
            continue
        if fields[0] not in {"127.0.0.1", "::1"}:
            raise CreationError(f"Hosts conflict for {domain}: {line}")
        found = True
    if found:
        return content
    separator = "\n" if content and not content.endswith("\n") else ""
    return f"{content}{separator}127.0.0.1\t{domain}\n::1\t{domain}\n"


def private_file(path: Path, content: str) -> None:
    with open(path, "x", opener=lambda name, flags: os.open(name, flags, 0o600)) as stream:
        stream.write(content)


def atomic_install(content: str, destination: Path, runner: CommandRunner, *, mode: int = 0o644,
                   previous: str | None = None) -> None:
    staged = destination.with_name(f".{destination.name}.{uuid4().hex}.tmp")
    with tempfile.TemporaryDirectory(prefix="newsite-") as temporary:
        source = Path(temporary) / "config"
        private_file(source, content)
        try:
            privileged(runner, ["install", "-m", f"{mode:04o}", str(source), str(staged)], "Installing temporary configuration")
            if previous is None:
                # Publish a complete file atomically without replacing any existing target.
                privileged(runner, ["ln", str(staged), str(destination)], "Publishing configuration")
            else:
                if destination.read_text() != previous:
                    raise CreationError(f"{destination} changed during site creation; inspect it before retrying.")
                privileged(runner, ["mv", "-f", str(staged), str(destination)], "Updating hosts")
        finally:
            runner(["sudo", "-n", "rm", "-f", str(staged)])


def update_hosts(domain: str, runner: CommandRunner) -> None:
    path = HOSTS_PATH.resolve(strict=True)
    content = path.read_text()
    updated = hosts_addition(content, domain)
    if updated != content:
        atomic_install(updated, path, runner, mode=stat.S_IMODE(path.stat().st_mode), previous=content)


def nginx_value(value: Path | str) -> str:
    text = str(value)
    if any(char in text for char in "\r\n\0"):
        raise CreationError("Nginx paths must not contain newlines or NUL bytes.")
    if re.fullmatch(r"[a-zA-Z0-9/._:@+-]+", text):
        return text
    return '"' + text.replace("\\", "\\\\").replace('"', '\\"').replace("$", "\\$") + '"'


def render_nginx(domain: str, site_dir: Path, config: RuntimeConfig) -> str:
    return f"""server {{
    listen 80;
    listen [::]:80;
    server_name {domain};
    root {nginx_value(site_dir)};
    index index.php index.html index.htm;
    client_max_body_size 64M;

    location / {{
        try_files $uri $uri/ /index.php?$args;
    }}
    location ~ \\.php$ {{
        try_files $uri =404;
        fastcgi_pass {nginx_value('unix:' + str(config.runtime.php_socket))};
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        include fastcgi_params;
    }}
    location ~ ^/(\\.user.ini|\\.htaccess|\\.git|\\.svn|\\.project|LICENSE|README.md) {{
        return 404;
    }}
    location ~ \\.well-known {{ allow all; }}
    location ~ .*\\.(gif|jpg|jpeg|png|bmp|swf)$ {{
        expires 30d; error_log off; access_log off;
    }}
    location ~ .*\\.(js|css)?$ {{
        expires 12h; error_log off; access_log off;
    }}
}}
"""


def _lsof_listeners(runner: CommandRunner) -> list[tuple[str, str, str]]:
    result = runner(["sudo", "-n", "lsof", "-nP", "+c", "0", "-iTCP:80", "-iTCP:443", "-sTCP:LISTEN", "-Fpcn"])
    if result.returncode not in {0, 1}:
        raise CreationError(f"Cannot inspect ports 80/443 using lsof: {result.stderr}. Install lsof or check sudo access.")
    listeners = []
    pid, name = "unknown", "unknown process"
    for line in result.stdout.splitlines():
        if line.startswith("p"):
            pid, name = line[1:], "unknown process"
        elif line.startswith("c"):
            name = line[1:]
        elif line.startswith("n"):
            listeners.append((name, pid, line.rsplit(":", 1)[-1]))
    valid = bool(listeners) and all(
        re.fullmatch(r"[1-9][0-9]*", pid) and name not in {"", "unknown process"} and port in {"80", "443"}
        for name, pid, port in listeners
    )
    diagnostic = result.stderr.strip()
    if diagnostic:
        # Only an unmatched requested address may accompany reliable results.
        # Match every complete line so mixed warnings/errors cannot be hidden.
        unmatched = all(re.fullmatch(r"lsof: (?:WARNING: )?Internet address not located: TCP:(?:80|443)", line.strip())
                        for line in diagnostic.splitlines() if line.strip())
        if result.returncode != 1 or not valid or not unmatched:
            raise CreationError(f"Cannot inspect ports 80/443 using lsof: {diagnostic}. Install lsof or check sudo access.")
        print(f"Warning: {diagnostic}", file=sys.stderr)
    if result.stdout.strip() and not valid:
        raise CreationError("Cannot inspect ports 80/443: lsof returned unrecognized listener information.")
    return listeners


def managed_nginx_pids(config: RuntimeConfig, runner: CommandRunner) -> set[str]:
    if ServiceManager(config.runtime, runner).status("nginx") != "active":
        return set()
    if config.runtime.platform == "linux":
        result = runner(["systemctl", "show", "nginx", "--property=MainPID", "--value"])
        main_pid = result.stdout.strip()
    else:
        result = runner(["launchctl", "print", f"system/{config.runtime.nginx_launchd_label}"])
        matches = re.findall(r"(?m)^\s*pid\s*=\s*([1-9][0-9]*)\s*$", result.stdout)
        main_pid = matches[0] if len(matches) == 1 else ""
    if result.returncode or not re.fullmatch(r"[1-9][0-9]*", main_pid):
        return set()
    processes = runner(["ps", "-axo", "pid=,ppid=,comm="])
    if processes.returncode:
        return set()
    parents = {}
    for line in processes.stdout.splitlines():
        fields = line.split(None, 2)
        if (len(fields) == 3 and fields[0].isdigit() and fields[1].isdigit()
                and Path(fields[2].split()[0]).name.rstrip(":") == "nginx"):
            parents[fields[0]] = fields[1]
    if main_pid not in parents:
        return set()
    # Nginx workers share listeners with the master; names alone cannot prove
    # ownership because independent masters use the same executable.
    owned = {main_pid}
    while True:
        children = {pid for pid, parent in parents.items() if parent in owned} - owned
        if not children:
            return owned
        owned.update(children)


def check_ports(config: RuntimeConfig, runner: CommandRunner) -> None:
    listeners = []
    if config.runtime.platform == "linux":
        result = runner(["sudo", "-n", "ss", "-ltnp", "( sport = :80 or sport = :443 )"])
        if result.returncode != 127:
            if result.returncode:
                raise CreationError(f"Cannot inspect ports 80/443: {result.stderr}")
            for line in result.stdout.splitlines():
                fields = line.split()
                if len(fields) < 5 or fields[0] != "LISTEN":
                    continue
                port = fields[3].rsplit(":", 1)[-1]
                processes = re.findall(r'\("([^\"]+)",pid=(\d+)', line)
                listeners.extend((name, pid, port) for name, pid in processes or [("unknown process", "unknown")])
        else:
            listeners = _lsof_listeners(runner)
    else:
        listeners = _lsof_listeners(runner)
    owned = managed_nginx_pids(config, runner) if any(name == "nginx" for name, _, _ in listeners) else set()
    for name, pid, port in listeners:
        if name != "nginx" or pid not in owned:
            detail = " Cannot verify ownership by the managed Nginx service." if name == "nginx" else ""
            raise CreationError(f"Port {port} is unavailable: {name} (PID {pid}).{detail} Free ports 80/443 before creating the site.")


def mysql_option(value: str) -> str:
    escaped = value.replace("\\", "\\\\").replace('"', '\\"').replace("\n", "\\n").replace("\r", "\\r").replace("\t", "\\t")
    if "\0" in escaped:
        raise CreationError("Database credentials must not contain NUL bytes.")
    return '"' + escaped + '"'


def runtime_binary(config: RuntimeConfig, name: str) -> str:
    if config.runtime.platform == "macos":
        return str(config.runtime.brew_prefix / "bin" / name)
    return name


def create_database(name: str, password: str, config: RuntimeConfig, runner: CommandRunner) -> None:
    with tempfile.TemporaryDirectory(prefix="newsite-") as temporary:
        options, query = Path(temporary) / "mysql.cnf", Path(temporary) / "database.sql"
        private_file(options, f"[client]\nuser={mysql_option(config.db_root_user)}\npassword={mysql_option(config.db_root_pass)}\n")
        private_file(query, f"""CREATE DATABASE `{name}` DEFAULT CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
CREATE USER '{name}'@'localhost' IDENTIFIED BY '{password}';
GRANT ALL PRIVILEGES ON `{name}`.* TO '{name}'@'localhost';
FLUSH PRIVILEGES;
""")
        checked(runner, ["sudo", "-n", sys.executable, "-c", MYSQL_STDIN, str(query), runtime_binary(config, "mysql"),
                         f"--defaults-extra-file={options}", "--batch", "--skip-force"],
                "Creating database", private=True)


def install_wordpress(site_dir: Path, db_name: str, password: str, runner: CommandRunner) -> None:
    with tempfile.TemporaryDirectory(prefix="newsite-") as temporary:
        archive = Path(temporary) / "wordpress.tar.gz"
        checked(runner, ["curl", "--fail", "--silent", "--show-error", "--location", "--max-time", "120",
                         f"https://wordpress.org/wordpress-{WP_VERSION}.tar.gz", "-o", str(archive)], "Downloading WordPress")
        with tarfile.open(archive, "r:gz") as bundle:
            members = bundle.getmembers()
            for member in members:
                path = PurePosixPath(member.name)
                if (path.is_absolute() or ".." in path.parts or not path.parts or path.parts[0] != "wordpress"
                        or not (member.isdir() or member.isfile())):
                    raise CreationError(f"Unsafe WordPress archive member: {member.name}")
            for member in members:
                parts = PurePosixPath(member.name).parts[1:]
                if not parts:
                    continue
                destination = site_dir.joinpath(*parts)
                if member.isdir():
                    destination.mkdir(parents=True, exist_ok=True)
                else:
                    destination.parent.mkdir(parents=True, exist_ok=True)
                    with bundle.extractfile(member) as source, destination.open("xb") as target:
                        shutil.copyfileobj(source, target)
                    destination.chmod(0o644)
        if not (site_dir / "wp-settings.php").is_file():
            raise CreationError("WordPress archive is missing wp-settings.php.")
    keys = ("AUTH_KEY", "SECURE_AUTH_KEY", "LOGGED_IN_KEY", "NONCE_KEY", "AUTH_SALT", "SECURE_AUTH_SALT", "LOGGED_IN_SALT", "NONCE_SALT")
    salts = "\n".join(f"define('{key}', '{secrets.token_urlsafe(48)}');" for key in keys)
    private_file(site_dir / "wp-config.php", f"""<?php
define('DB_NAME', '{db_name}');
define('DB_USER', '{db_name}');
define('DB_PASSWORD', '{password}');
define('DB_HOST', 'localhost');
define('DB_CHARSET', 'utf8mb4');
define('DB_COLLATE', '');
define('WP_DEBUG', false);
define('WP_AUTO_UPDATE_CORE', false);
define('FS_METHOD', 'direct');

$table_prefix = 'wp_';

{salts}

if (!defined('ABSPATH')) define('ABSPATH', __DIR__ . '/');
require_once ABSPATH . 'wp-settings.php';
""")
    (site_dir / "wp-config.php").chmod(0o640)
    for path in site_dir.rglob("*"):
        if path.is_dir():
            path.chmod(0o755)


def create_site(domain: str, wp: bool, config: RuntimeConfig, runner: CommandRunner) -> CreateResult:
    site_dir = config.webroot
    try:
        domain = validate_domain(domain)
        site_dir = config.webroot / domain
        conf = config.runtime.nginx_available / f"{domain}.conf"
        enabled = config.runtime.nginx_enabled / conf.name
        db_name = re.sub(r"[^a-z0-9_]", "_", domain.split(".", 1)[0])
        if len(db_name) > 32:
            raise CreationError("The first domain label must be at most 32 characters for a MySQL user name.")
        for path in (site_dir, conf, enabled):
            if os.path.lexists(path):
                raise CreationError(f"Site target already exists: {path}. Refusing to overwrite it.")
        hosts_addition(HOSTS_PATH.read_text(), domain)
        text = render_nginx(domain, site_dir, config)
        check_ports(config, runner)
        print(f"🚀 Creating site: {domain}")
        print(f"[1/7] Creating directory {site_dir}...")
        site_dir.parent.mkdir(parents=True, exist_ok=True)
        site_dir.mkdir(mode=0o755)
        site_dir.chmod(0o755)
        print("[2/7] Creating Nginx config...")
        privileged(runner, ["mkdir", "-p", str(conf.parent), str(enabled.parent)], "Creating Nginx directories")
        atomic_install(text, conf, runner)
        print("[3/7] Enabling site...")
        privileged(runner, ["ln", "-s", str(conf), str(enabled)], "Enabling site")
        print("[4/7] Adding to /etc/hosts...")
        update_hosts(domain, runner)
        print("[5/7] Creating MySQL database...")
        password = secrets.token_urlsafe(24)
        create_database(db_name, password, config, runner)
        if wp:
            print("[6/7] Installing WordPress...")
            install_wordpress(site_dir, db_name, password, runner)
        else:
            print("[6/7] Skipping WordPress install.")
        privileged(runner, ["chown", "-R", f"{config.web_user}:{config.web_group}", str(site_dir)], "Setting site ownership")
        print("[7/7] Finishing...")
        nginx = runtime_binary(config, "nginx")
        privileged(runner, [nginx, "-t"], "Validating Nginx configuration")
        check_ports(config, runner)
        command = ["systemctl", "reload", "nginx"] if config.runtime.platform == "linux" else [nginx, "-s", "reload"]
        privileged(runner, command, "Reloading Nginx")
        check_ports(config, runner)
        print(f"\n✅ Site created: http://{domain}")
        if wp:
            print(f"\n📝 WordPress Credentials:\n   Site:    http://{domain}/wp-admin/install.php\n"
                  f"   DB Name: {db_name}\n   DB User: {db_name}\n   DB Pass: {password}")
        print(f"\n💡 To add SSL later: sudo -n certbot --nginx -d {domain}")
        return CreateResult(True, domain, site_dir, db_password=password)
    except (CreationError, OSError, tarfile.TarError) as error:
        message = str(error)
        print(f"Error: {message}")
        return CreateResult(False, domain, site_dir, error=message)


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="newsite", usage="newsite <domain.test> [--wp]",
                                     description="Create a new Nginx site. Example: newsite ah.test --wp")
    parser.add_argument("domain", help="Site domain, e.g. example.test")
    parser.add_argument("--wp", action="store_true", help="Install WordPress")
    try:
        args = parser.parse_args(argv)
    except SystemExit as error:
        return int(error.code)
    try:
        config = load_config()
    except (RuntimeError, OSError) as error:
        print(f"Error: {error}")
        return 1
    return 0 if create_site(args.domain, args.wp, config, run_command).success else 1


if __name__ == "__main__":
    raise SystemExit(main())
