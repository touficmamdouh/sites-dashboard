#!/bin/bash
# newsite - Create a new Nginx site with optional WordPress install
# Usage: newsite <domain> [--wp]

set -e

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; NC='\033[0m'

if [ -z "$1" ]; then
    echo -e "${RED}Usage: newsite <domain.test> [--wp]${NC}"
    echo "  Example: newsite ah.test --wp"
    exit 1
fi

DOMAIN="$1"
INSTALL_WP=false
[ "$2" = "--wp" ] && INSTALL_WP=true

# Paths (configurable via env; defaults to current user)
WWW_DIR="${SITES_WEBROOT:-$HOME/www}"
SITES_AVAILABLE="${NGINX_AVAILABLE:-/etc/nginx/sites-available}"
SITES_ENABLED="${NGINX_ENABLED:-/etc/nginx/sites-enabled}"
PHP_SOCK="${SITES_PHP_SOCK:-/run/php/php8.3-fpm.sock}"
DB_ROOT_USER="${SITES_DB_ROOT_USER:-root}"
DB_ROOT_PASS="${SITES_DB_ROOT_PASS:-root}"
SITE_USER="${SITES_WEB_USER:-$(whoami)}"
SITE_DIR="$WWW_DIR/$DOMAIN"
NGINX_CONF="$SITES_AVAILABLE/$DOMAIN.conf"
DB_NAME="${DOMAIN%%.*}"
DB_NAME="${DB_NAME//[^a-zA-Z0-9_]/_}"
WP_VERSION="6.7"

echo -e "${YELLOW}🚀 Creating site: $DOMAIN${NC}"

# 1. Create directory
echo -e "${GREEN}[1/7]${NC} Creating directory $SITE_DIR..."
mkdir -p "$SITE_DIR"

# 2. Create Nginx config
echo -e "${GREEN}[2/7]${NC} Creating Nginx config..."
sudo -n tee "$NGINX_CONF" > /dev/null << NGINX
server {
    listen 80;
    listen [::]:80;
    server_name $DOMAIN;
    root $SITE_DIR;
    index index.php index.html index.htm;

    client_max_body_size 64M;

    location / {
        try_files \$uri \$uri/ /index.php?\$args;
    }

    location ~ \.php\$ {
        try_files \$uri =404;
        fastcgi_pass unix:${PHP_SOCK};
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME \$document_root\$fastcgi_script_name;
        include fastcgi_params;
    }

    location ~ ^/(\.user.ini|\.htaccess|\.git|\.svn|\.project|LICENSE|README.md) {
        return 404;
    }

    location ~ \.well-known { allow all; }

    location ~ .*\.(gif|jpg|jpeg|png|bmp|swf)\$ {
        expires 30d; error_log off; access_log off;
    }

    location ~ .*\.(js|css)?\$ {
        expires 12h; error_log off; access_log off;
    }
}
NGINX

# 3. Enable site
echo -e "${GREEN}[3/7]${NC} Enabling site..."
sudo -n ln -sf "$NGINX_CONF" "$SITES_ENABLED/"

# 4. Add to /etc/hosts
echo -e "${GREEN}[4/7]${NC} Adding to /etc/hosts..."
if ! grep -q "^127\.0\.0\.1\s\+$DOMAIN" /etc/hosts; then
    sudo -n sed -i "/^127\.0\.0\.1\s\+localhost/a 127.0.0.1\t$DOMAIN" /etc/hosts
    sudo -n sed -i "/^::1\s\+ip6-localhost/a ::1\t$DOMAIN" /etc/hosts
fi

# 5. Create database
echo -e "${GREEN}[5/7]${NC} Creating MySQL database..."
DB_PASS=$(openssl rand -base64 12)
sudo -n mysql -u "${DB_ROOT_USER}" -p"${DB_ROOT_PASS}" -e "
    CREATE DATABASE IF NOT EXISTS ${DB_NAME} /*!40100 DEFAULT CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci */;
    DROP USER IF EXISTS '${DB_NAME}'@'localhost';
    CREATE USER '${DB_NAME}'@'localhost' IDENTIFIED BY '${DB_PASS}';
    GRANT ALL PRIVILEGES ON ${DB_NAME}.* TO '${DB_NAME}'@'localhost';
    FLUSH PRIVILEGES;
" 2>&1

# 6. Install WordPress
if [ "$INSTALL_WP" = true ]; then
    echo -e "${GREEN}[6/7]${NC} Installing WordPress..."
    
    # Download WP
    cd /tmp
    curl -sL "https://wordpress.org/wordpress-$WP_VERSION.tar.gz" -o wordpress.tar.gz
    tar xzf wordpress.tar.gz
    cp -r wordpress/* "$SITE_DIR/"
    rm -rf wordpress wordpress.tar.gz
    
    # Set permissions
    sudo -n chown -R "${SITE_USER}":"${SITE_USER}" "$SITE_DIR"
    
    # Generate salts first
    SALTS=$(curl -s https://api.wordpress.org/secret-key/1.1/salt/)
    
    # Create wp-config (salts BEFORE wp-settings.php)
    cat > "$SITE_DIR/wp-config.php" << WP
<?php
define('DB_NAME', '${DB_NAME}');
define('DB_USER', '${DB_NAME}');
define('DB_PASSWORD', '${DB_PASS}');
define('DB_HOST', 'localhost');
define('DB_CHARSET', 'utf8mb4');
define('DB_COLLATE', '');
define('WP_DEBUG', false);
define('WP_AUTO_UPDATE_CORE', false);
define('FS_METHOD', 'direct');

\$table_prefix = 'wp_';

${SALTS}

if (!defined('ABSPATH')) define('ABSPATH', __DIR__ . '/');
require_once ABSPATH . 'wp-settings.php';
WP
    
    # Set WP files ownership
    chown -R "${SITE_USER}":"${SITE_USER}" "$SITE_DIR"
    find "$SITE_DIR" -type d -exec chmod 755 {} \;
    find "$SITE_DIR" -type f -exec chmod 644 {} \;
    
    echo -e "${GREEN}[7/7]${NC} Finishing..."
else
    echo -e "${GREEN}[6/7]${NC} Skipping WordPress install."
    sudo -n chown -R "${SITE_USER}":"${SITE_USER}" "$SITE_DIR"
    echo -e "${GREEN}[7/7]${NC} Finishing..."
fi

# Reload Nginx
sudo -n nginx -t && sudo -n systemctl reload nginx

# Done
echo ""
echo -e "${GREEN}✅ Site created: http://$DOMAIN${NC}"
if [ "$INSTALL_WP" = true ]; then
    echo ""
    echo "📝 WordPress Credentials:"
    echo "   Site:    http://$DOMAIN/wp-admin/install.php"
    echo "   DB Name: $DB_NAME"
    echo "   DB User: $DB_NAME"
    echo "   DB Pass: $DB_PASS"
fi
echo ""
echo -e "${YELLOW}💡 To add SSL later:${NC} sudo -n certbot --nginx -d $DOMAIN"
