<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sites-dashboard.nginx</string>
    <key>SitesDashboardOwner</key>
    <string>${owner}</string>
    <key>ProgramArguments</key>
    <array>
        <string>${nginx}</string>
        <string>-c</string>
        <string>${config}</string>
        <string>-g</string>
        <string>daemon off; user ${owner} ${group};</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>${stdout}</string>
    <key>StandardErrorPath</key>
    <string>${stderr}</string>
</dict>
</plist>
